# Copy to .env and provide verified production values. Never commit secrets.
PORT=3000
SITE_URL=http://localhost:3000
# Set true only after brand, legal and business review. Enables indexing.
PUBLIC_SITE=false
# Email delivery through Resend. Sender must be verified with the provider.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Required for contact delivery in production; optional for local development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set true ONLY behind a trusted reverse proxy that replaces client IP headers.
TRUST_PROXY=false

# Shared content editor: connect a PRIVATE Vercel Blob store to this project.
# Vercel-connected stores use BLOB_STORE_ID and managed OIDC automatically.
# A static token is an alternative for code running outside Vercel.
BLOB_READ_WRITE_TOKEN=
# Use two DIFFERENT randomly generated passwords, at least 16 characters each.
# Team members save drafts; only the owner password can publish or restore.
CMS_EDITOR_PASSWORD=
CMS_OWNER_PASSWORD=
# Optional for local development only. Never enable local storage on Vercel.
CMS_LOCAL_STORAGE=false
